# Copy to .env. Plasmo inlines PLASMO_PUBLIC_* at build time and substitutes
# $PLASMO_PUBLIC_* in package.json's manifest block (used for host_permissions).
#
# IMPORTANT: keep the value an origin only (scheme + host, no path), e.g.
#   https://app.quickreplies.io   ✓
#   https://app.quickreplies.io/  ✗  (trailing slash breaks the host_permissions match)

# Production URL of the QuickReplies website / API.
PLASMO_PUBLIC_API_BASE_URL=https://app.quickreplies.io

# Sentry DSN — leave empty to disable error reporting from the extension.
PLASMO_PUBLIC_SENTRY_DSN=
